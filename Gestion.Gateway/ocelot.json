{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/Evento/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7117
        }
      ],
      "UpstreamPathTemplate": "/gateway/Evento/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 10
      },
      "FileCacheOptions": {
        "TtlSeconds": 10,
        "Region": "eventosCache"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Participante/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7117
        }
      ],
      "UpstreamPathTemplate": "/gateway/Participante/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 10
      },
      "FileCacheOptions": {
        "TtlSeconds": 10,
        "Region": "participantesCache"
      }
    },
    {
      "DownstreamPathTemplate": "/api/Organizador/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7117
        }
      ],
      "UpstreamPathTemplate": "/gateway/Organizador/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 10
      },
      "FileCacheOptions": {
        "TtlSeconds": 10,
        "Region": "organizadoresCache"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7006",
    "RateLimitOptions": {
      "ClientIdHeader": "X-Client-Id",
      "QuotaExceededMessage": "Has superado el limite de 10 peticiones por minuto.",
      "HttpStatusCode": 429
    }
  }
}